# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# By default, ignore the artifacts produced by the debugger
*.rlib

# IntelliJ related
.idea/

# VS Code settings
.vscode/

# Other editors
*.swp
*~
.DS_Store

# Windows thumbnail cache
Thumbs.db

# log files
*.log

# temporary files
*.tmp

# build output from Rust/Cargo
**/debug/
**/release/

# Optional: user-specific files
.env

# IDE project files
*.iml

# claude
.claude
debug_output.txt
